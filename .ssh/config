# Reference copy of the SSH configuration on Gijs's Mac.
# install.sh does not install this file. Adapt paths before using on another host.
# The IdentityAgent socket below is specific to 1Password on macOS.
# IdentityFile paths refer to local files, which are not included in this repo.
# For .pub identities, the matching private key must be available in the agent.

# Added by OrbStack: 'orb' SSH host for Linux machines
# This only works if it's at the top of ssh_config (before any Host blocks).
# This won't be added again if you remove it.
Include ~/.orbstack/ssh/config

Host *
  IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"

Host homer
  HostName homer.lifelog.be
  User gijs
  IdentityFile ~/.ssh/hetzner_server_action_ed25519
  IdentitiesOnly yes
  ServerAliveInterval 2
  ServerAliveCountMax 2
  TCPKeepAlive no
  ConnectTimeout 5
  ConnectionAttempts 1

Host dokploy
  HostName dokploy
  User root
  ServerAliveInterval 2
  ServerAliveCountMax 2
  TCPKeepAlive no
  ConnectTimeout 5
  ConnectionAttempts 1

Host mini mini.local
  HostName mini.local
  User gijs
  IdentityFile ~/.ssh/id_ed25519.pub
  IdentitiesOnly yes

Host home home.lifelog.be
  HostName home.lifelog.be
  User root
  IdentityFile ~/.ssh/id_ed25519.pub
  IdentitiesOnly yes
