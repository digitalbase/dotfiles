#!/usr/bin/env bash
set -euo pipefail

host="${1:-homer}"
session="${2:-main}"
window="${3:-$host}"

case "$session" in
  *[!A-Za-z0-9_.-]*|'')
    printf 'Invalid tmux session name: %s\n' "$session" >&2
    exit 2
    ;;
esac

trap 'stty sane 2>/dev/null || true; printf "\nexiting\n"; exit 0' INT TERM

cleanup_terminal() {
  stty sane 2>/dev/null || true
  # RIS + clear screen. Avoid `reset`, which can print terminfo sequences as text
  # while the shell prompt is redrawing after a broken SSH session.
  printf '\033c\033[2J\033[H'
}

if [ -n "${TMUX:-}" ] && command -v tmux >/dev/null 2>&1; then
  tmux rename-window "$window"
fi

while true; do
  status=0
  ssh -tt \
    -o ServerAliveInterval=3 \
    -o ServerAliveCountMax=2 \
    -o TCPKeepAlive=yes \
    "$host" "PATH=/opt/homebrew/bin:/usr/local/bin:\$PATH; exec tmux new-session -A -s '$session'" || status=$?

  # Broken SSH sessions can leave the terminal in an inconsistent state.
  cleanup_terminal

  printf '\nDisconnected from %s/%s; reconnecting in 1s... exit=%s\n' "$host" "$session" "$status" >&2
  sleep 1
done
